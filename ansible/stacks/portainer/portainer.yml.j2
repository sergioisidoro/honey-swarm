version: "3.7"

services:
  agent:
    image: {{portainer_agent_image}}
    environment:
      AGENT_CLUSTER_ADDR: tasks.agent
      AGENT_PORT: 9001
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - /var/lib/docker/volumes:/var/lib/docker/volumes
    networks:
      - portainer-network
    deploy:
      mode: global

  portainer:
    image: {{portainer_image}}
    command: -H tcp://tasks.agent:9001 --tlsskipverify
    # No host-published ports on purpose. Docker bypasses UFW when it publishes
    # ports, which would expose the Portainer UI (9000) directly on the public
    # IP without TLS. The UI is reachable through Traefik (portainer.{{ domains.main }})
    # over HTTPS via the labels below. If you use Portainer Edge agents and need
    # the tunnel, re-add only `target: 8000` bound to a trusted interface.
    volumes:
      - /var/run/docker.sock:/var/run/docker.sock
      - portainer-data:/data
    networks:
      - portainer-network
      - public-network
    restart: always
    deploy:
      mode: replicated
      replicas: 1
      labels:
        - traefik.enable=true
        - traefik.http.services.portainer.loadbalancer.server.port=9000
        - traefik.http.routers.portainer.rule=Host(`portainer.{{ domains.main }}`)
        - traefik.http.routers.portainer.entrypoints=http,https
      placement:
        constraints: [node.role == manager]
      update_config:
        parallelism: 1
        delay: 10s
        order: start-first
      rollback_config:
        parallelism: 1
        order: start-first

volumes:
  # SINGLE-NODE ASSUMPTION: node-local volume. Portainer's users, stack
  # definitions and webhook ids live here and do NOT move with the service if it
  # is rescheduled onto another node. It is also NOT captured by this repo — see
  # the disaster-recovery section of infrastructure/readme.md.
  portainer-data:

networks:
  portainer-network:
  public-network:
    external: true
